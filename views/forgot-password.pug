extends layout

block content
  .frame
    .auth-split
      .auth-aside
        span.eyebrow.ember Account recovery
        h1 A fresh start is #[em one email away.]
        p We’ll send you a secure, one-time link to choose a new password.
        img(src='/img/showcase/anniversary.jpg' alt='Sample anniversary invitation card' width='600' height='833')
      .auth-panel
        h2 Reset your password
        p.sub Enter the email address linked to your account.
        if error
          .alert.alert-danger(role='alert')= error
        if success
          .alert.alert-success(role='status')= success
        form(method='post' action='/forgot-password' novalidate)
          .mb-4
            label.form-label(for='email') Email
            input#email.form-control(type='email' name='email' value=email required autocomplete='email' autofocus)
          button.btn.btn-primary.btn-lg.w-100(type='submit') Send reset link
        p.mt-4.mb-0.muted
          a(href='/login') Back to sign in
