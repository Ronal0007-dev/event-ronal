extends layout

block content
  .frame
    .auth-split
      .auth-aside
        span.eyebrow.ember Account recovery
        h1 Choose a password that’s #[em yours.]
        p Reset links expire after 30 minutes and can only be used once.
        img(src='/img/showcase/anniversary.jpg' alt='Sample anniversary invitation card' width='600' height='833')
      .auth-panel
        h2 Choose a new password
        p.sub Use at least 8 characters.
        if error
          .alert.alert-danger(role='alert')= error
        if token
          form(method='post' action='/reset-password' novalidate)
            input(type='hidden' name='token' value=token)
            .mb-4
              label.form-label(for='password') New password
              .password-input-wrap
                input#password.form-control(type='password' name='password' minlength='8' required autocomplete='new-password')
                button.password-toggle(type='button' aria-label='Show password' aria-pressed='false' data-password-toggle)
                  i.bi.bi-eye(aria-hidden='true')
            .mb-4
              label.form-label(for='confirmPassword') Confirm new password
              .password-input-wrap
                input#confirmPassword.form-control(type='password' name='confirmPassword' minlength='8' required autocomplete='new-password')
                button.password-toggle(type='button' aria-label='Show password' aria-pressed='false' data-password-toggle)
                  i.bi.bi-eye(aria-hidden='true')
            button.btn.btn-primary.btn-lg.w-100(type='submit') Update password
        else
          a.btn.btn-primary.btn-lg.w-100(href='/forgot-password') Request a new reset link
        p.mt-4.mb-0.muted
          a(href='/login') Back to sign in
